+def export_plan(candidate):
+    config = candidate['Id']
+    diffs = candidate['RootFS']['Layers']
+    for value in [config]+diffs:
+        if not isinstance(value,str) or len(value)!=71 or not value.startswith('sha256:'):
+            raise ValueError('Invalid Docker content identifier')
+        if any(c not in '0123456789abcdef' for c in value[7:]):
+            raise ValueError('Invalid Docker content identifier')
+    return {'Config':'blobs/sha256/'+config[7:],
+            'Layers':['blobs/sha256/'+d[7:] for d in diffs]}
+
+
+def verify_export_manifest(actual, planned):
+    if not isinstance(actual,list) or len(actual)!=1 or not isinstance(actual[0],dict):
+        raise ValueError('Expected one Docker export manifest entry')
+    item=actual[0]
+    if item.get('Config')!=planned['Config'] or item.get('Layers')!=planned['Layers']:
+        raise ValueError('Observed Docker archive layout differs from verified content IDs')
+    return {'Config':item['Config'],'Layers':item['Layers']}
 
 

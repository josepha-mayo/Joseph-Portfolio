+_LOG_EQUALS = re.compile(
+    r'(?<!\w)('
+    r'part[ \t]+(?:number|no)|serial[ \t]+number|'
+    r'ticket[ \t]+id|issue[ \t]+id|bug[ \t]+id|case[ \t]+id|defect[ \t]+id|'
+    r'fixed[ \t]+in|fixed[ \t]+version|firmware[ \t]+version|fix[ \t]+version|resolved[ \t]+in|'
+    r'[A-Za-z][A-Za-z0-9_]*'
+    r')[ \t]*=[ \t]*(?:"([^"\r\n]*)"|([^\s]+))', re.I)
+
+
+def _log_equals_pairs(text):
+    """Tokenize top-level key=value fields without rescanning quoted values.
+
+    A quoted unknown field such as Note="Product=PX-999 is deprecated" is one
+    token. Scope-looking text inside that quoted value must never become a
+    second top-level declaration.
+    """
+    for line in text.splitlines():
+        pos = 0
+        size = len(line)
+        while pos < size:
+            match = _LOG_EQUALS.search(line, pos)
+            if match is None:
+                break
+            name = match.group(1)
+            value = match.group(2) if match.group(2) is not None else match.group(3)
+            yield name, value
+            pos = match.end()
@@

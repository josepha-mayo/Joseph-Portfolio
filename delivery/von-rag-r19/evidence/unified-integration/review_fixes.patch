+"""Reviewer-discovered specificity/current-authority controls, scripted only."""
+import json
+import pytest
+from von_rag.parsers import Chunk
+from von_rag.compact import parse_selection
+from von_rag.proofs import GroundingError
+
+QUERY=('The PX-418 production log reports voltage drift. '
+       'Which firmware release addressed the underlying defect?')
+ROOT='product=PX-418 asset=BOARD-88 event="voltage drift" ticket=CASE-9999'
+VALUE='Asset: BOARD-88\nTicket: CASE-9999\nFixed in: 4.3.2\nStatus: current'
+
+def row(source,text):return Chunk(source,'record:1.0',text).dict()
+def result(value,other):
+    records=[row('events.log',ROOT),row('release.txt',value),row('other.txt',other)]
+    return parse_selection(json.dumps(['4.3.2',[0,1]]),records,QUERY)
+
+@pytest.mark.parametrize('primary',['Product','Model','Device'])
+@pytest.mark.parametrize('value_primary,other_primary',[(False,True),(True,False)])
+def test_matching_primary_specificity_cannot_hide_current_conflict(primary,value_primary,other_primary):
+    value=(f'{primary}: PX-418\n' if value_primary else '')+VALUE
+    other=(f'{primary}: PX-418\n' if other_primary else '')+VALUE.replace('4.3.2','4.3.3')
+    with pytest.raises(GroundingError):result(value,other)
+
+@pytest.mark.parametrize('primary',['Product','Model','Device'])
+def test_explicitly_other_primary_does_not_conflict(primary):
+    other=f'{primary}: OTHER-99\n'+VALUE.replace('4.3.2','4.3.3')
+    out,_=result(VALUE,other)
+    assert out['answer']=='4.3.2'
+    assert out['citations']==['events.log','release.txt']
+
+@pytest.mark.parametrize('status',['draft','proposed','pending','unknown'])
+def test_noncurrent_record_does_not_override_current_answer(status):
+    other=VALUE.replace('4.3.2','4.3.3').replace('current',status)
+    out,_=result(VALUE,other)
+    assert out['answer']=='4.3.2'
+
+def test_extra_secondary_qualifier_cannot_hide_matching_current_conflict():
+    other='Product: PX-418\nPart Number: PN-001\n'+VALUE.replace('4.3.2','4.3.3')
+    with pytest.raises(GroundingError):result(VALUE,other)

--- a/delivery/von-rag-r19/tests/test_r70_explicit_status_boundaries.py
+++ b/delivery/von-rag-r19/tests/test_r70_explicit_status_boundaries.py
@@ -0,0 +1,65 @@
+"""Literal opposing status records, including the independent three-fragment report."""
+import pytest
+from von_rag.parsers import text_chunks
+from von_rag.retrieval import build_index, Index
+
+
+def indexed(tmp_path,text):
+    corpus=tmp_path/'corpus';corpus.mkdir()
+    (corpus/'mixed.txt').write_text(text)
+    db=tmp_path/'index.sqlite'
+    receipt=build_index(corpus,db,file_timeout=15,deadline_seconds=50)
+    assert receipt['skipped']==[]
+    return Index(db,corpus)
+
+
+@pytest.mark.parametrize('first,second',[('Product','Part Number'),('Asset','Serial Number')])
+@pytest.mark.parametrize('status',['withdrawn','superseded'])
+def test_scoped_middle_status_does_not_retire_later_current_entity(tmp_path,first,second,status):
+    filler=('Record narrative without any metadata labels.\n'*150)[:4200]
+    text=(f'{first}: OLD-100\nMaximum junction temperature: 105\n'+filler+
+          f'\nStatus: {status}\n'+filler+
+          f'\n{second}: NEW-200\nStatus: current\nMaximum junction temperature: 94\n')
+    ix=indexed(tmp_path,text)
+    try:
+        rows=ix.all()
+        new=[r for r in rows if 'NEW-200' in r['text']]
+        assert new and all(not r['retired'] for r in new)
+        assert all(r['retired'] for r in rows if r not in new)
+        assert any('NEW-200' in r['text'] for r in ix.search('NEW-200',k=20,historical=False))
+    finally:ix.close()
+
+
+@pytest.mark.parametrize('first,second',[('Product','Part Number'),('Asset','Serial Number')])
+def test_current_record_does_not_inherit_later_different_entity_withdrawal(tmp_path,first,second):
+    filler=('Current record explanation without field labels.\n'*150)[:4200]
+    text=(f'{first}: NEW-200\nStatus: current\n'+filler+
+          '\nMaximum junction temperature: 94\n'+
+          f'{second}: OLD-100\nStatus: withdrawn\nMaximum junction temperature: 105\n')
+    ix=indexed(tmp_path,text)
+    try:
+        rows=ix.all();old=[r for r in rows if 'OLD-100' in r['text']]
+        assert old and all(r['retired'] for r in old)
+        assert all(not r['retired'] for r in rows if r not in old)
+    finally:ix.close()
+
+
+@pytest.mark.parametrize('status',['current','withdrawn'])
+def test_complementary_field_without_its_own_status_is_not_split(status):
+    text=f'Product: TQ-40\nStatus: {status}\nPart Number: FAN-2214-B\n'
+    chunks=text_chunks(text,'one.txt')
+    assert len(chunks)==1
+    assert chunks[0].fields['Product']=='TQ-40'
+    assert chunks[0].fields['Part Number']=='FAN-2214-B'
+
+
+@pytest.mark.parametrize('alias',['TQ-40','TQ40'])
+def test_same_identifier_under_an_alias_is_not_a_new_record(alias):
+    text=f'Product: TQ-40\nStatus: withdrawn\nModel: {alias}\nStatus: current\n'
+    assert len(text_chunks(text,'one.txt'))==1
+
+
+@pytest.mark.parametrize('status',['current','draft'])
+def test_same_or_unknown_status_does_not_invent_a_cross_key_boundary(status):
+    text=f'Product: TQ-40\nStatus: current\nPart Number: FAN-2214-B\nStatus: {status}\n'
+    assert len(text_chunks(text,'one.txt'))==1

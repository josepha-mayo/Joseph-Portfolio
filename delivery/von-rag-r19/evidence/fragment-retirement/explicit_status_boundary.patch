+def _explicit_record_state(lines):
+    """Return one unambiguous literal state; unknown or mixed states stay opaque."""
+    states = set()
+    for line in lines:
+        match = re.match(r'^\s*status\s*:\s*([a-z]+)\b', line, re.I)
+        if not match:
+            continue
+        value = match.group(1).casefold()
+        if value in {'withdrawn', 'superseded', 'obsolete', 'deprecated', 'archived'}:
+            states.add('retired')
+        elif value == 'current':
+            states.add('current')
+        else:
+            return None
+    return next(iter(states)) if len(states) == 1 else None
+

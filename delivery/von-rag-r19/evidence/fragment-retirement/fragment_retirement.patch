+def fragment_retirement_states(chunks):
+    """Carry retirement across fragments of one literal parser record.
+
+    Only text_chunks' numeric-offset locators are grouped. Distinct paragraphs,
+    pages, literal records, table rows and image transcriptions stay separate.
+    Source text, field values and citation identifiers are never synthesized.
+    """
+    groups = collections.defaultdict(list)
+    for chunk in chunks:
+        # Single record: text:1.0 / text:1.3500
+        # Split records: text:1.1.0 / text:1.1.3500 / text:1.2.0
+        fragmented = (chunk.kind == 'text' and
+                      re.fullmatch(r'.+:\d+(?:\.\d+)?\.\d+', chunk.locator))
+        group = ('text', chunk.source, chunk.locator.rsplit('.', 1)[0]) if fragmented else ('single', chunk.cid)
+        groups[group].append(chunk)
+    entity_keys = {
+        'product', 'model', 'device', 'partnumber', 'partno', 'pn', 'sku',
+        'asset', 'component', 'serialnumber', 'item', 'assembly', 'module'
+    }
+    document_retired = False
+    flags = {}
+    for members in groups.values():
+        scoped = len(members) > 1 and any(
+            {_key for name in kv_fields(c.text)
+             if (_key := re.sub(r'[^a-z0-9]', '', name.casefold()))} & entity_keys
+            for c in members)
+        # A status-only tail has no scope locally, but belongs to the same
+        # literal record as its header. It cannot retire unrelated siblings.
+        if not scoped and any(document_retirement_marker(c) for c in members):
+            document_retired = True
+        record_retired = any(retired('', c.text) for c in members)
+        for c in members:
+            flags[c.cid] = record_retired
+    return document_retired, flags
 
 
